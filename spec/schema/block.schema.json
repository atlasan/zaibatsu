{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaibatsu/spec/schema/block.schema.json",
  "title": "Information block",
  "description": "A hexagonal Cybernet tile. See DOCS/domain-model.md.",
  "type": "object",
  "required": ["id", "name", "expansion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "expansion": { "enum": ["speedrunners", "shadowraiders"] },
    "layoutId": {
      "const": "standard-seven-small-hex-grid",
      "default": "standard-seven-small-hex-grid",
      "description": "Every information block card uses the seven-position printed small-hex layout declared in spec/data/block-layouts.json."
    },
    "isCentralCore": { "type": "boolean", "default": false },
    "iceValue": {
      "enum": ["none", "low", "medium", "high", "black"],
      "default": "none",
      "description": "low=3 dice, medium=2, high=1, black=Black ICE"
    },
    "edges": {
      "type": "array",
      "description": "Six hex sides; true = the side exposes a connecting space.",
      "items": { "type": "boolean" },
      "minItems": 6,
      "maxItems": 6
    },
    "boundarySpaces": {
      "type": "array",
      "description": "The local space ids exposed by each of the six edges. Index matches edges; empty array means no boundary space.",
      "items": { "type": "array", "items": { "type": "string" } },
      "minItems": 6,
      "maxItems": 6
    },
    "bonusFragments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "default": 0,
      "description": "Count of one-third bonus-icon corners on this block."
    },
    "bonusCorners": {
      "type": "array",
      "description": "Visual/source layout: six clockwise corner flags. The true count must equal bonusFragments.",
      "items": { "type": "boolean" },
      "minItems": 6,
      "maxItems": 6
    },
    "spaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/space" }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inCybernet": { "type": "string", "description": "Effect id fired on placement." },
        "underControl": { "type": "string", "description": "Effect id fired on gaining control." }
      }
    },
    "assetRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true,
      "description": "Physical asset ids resolved through spec/assets/manifest.json."
    },
    "provisional": { "type": "boolean", "default": false }
  },
  "$defs": {
    "spaceGridCell": {
      "description": "One of the seven declared small-hex positions in the standard block layout.",
      "oneOf": [
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": 0 }, "r": { "const": 0 } } },
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": 0 }, "r": { "const": -1 } } },
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": 1 }, "r": { "const": -1 } } },
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": 1 }, "r": { "const": 0 } } },
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": 0 }, "r": { "const": 1 } } },
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": -1 }, "r": { "const": 1 } } },
        { "type": "object", "required": ["q", "r"], "additionalProperties": false, "properties": { "q": { "const": -1 }, "r": { "const": 0 } } }
      ]
    },    "spaceFootprint": {
      "type": "object",
      "required": ["shape", "cells"],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": ["hex", "pill", "large"],
          "description": "hex = one printed cell; pill = two adjacent printed cells; large = one or more connected printed cells."
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/spaceGridCell" }
        }
      }
    },
    "space": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["normal", "double", "special", "pawn", "effect"] },
        "pawnId": { "type": "string" },
        "effectId": { "type": "string" },
        "location": {
          "type": "object",
          "description": "Visual/source layout only: normalized position in the block crop (0..100); it does not define game movement.",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 100 },
            "y": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "footprint": {
          "$ref": "#/$defs/spaceFootprint",
          "description": "Visual/source layout footprint on the block internal pointy-hex grid. It describes printed space coverage only; it does not define movement adjacency or alter gameplay capacity."
        },
        "neighbors": {
          "type": "array",
          "description": "Intra-block adjacent space ids used for step movement.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "modifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["defense", "hand-size", "attack"] },
            "amount": { "type": "integer" }
          }
        }
      }
    }
  }
}
