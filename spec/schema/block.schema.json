{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaibatsu/spec/schema/block.schema.json",
  "title": "Information block",
  "description": "A hexagonal Cybernet tile. Seven standardized internal placement hexes map source-marked gameplay spaces; capacity and neighbours are explicit data.",
  "type": "object",
  "required": [
    "id",
    "name",
    "expansion"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "expansion": {
      "enum": [
        "speedrunners",
        "shadowraiders"
      ]
    },
    "layoutId": {
      "const": "standard-seven-zone-2-3-2-pointy",
      "default": "standard-seven-zone-2-3-2-pointy"
    },
    "isCentralCore": {
      "type": "boolean",
      "default": false
    },
    "iceValue": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "black"
      ],
      "default": "none"
    },
    "iceFaces": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "maxItems": 6,
      "uniqueItems": false,
      "description": "The specific 1-6 die faces the Icebreak roll must match. When present the engine uses these exact faces instead of deriving them from iceValue."
    },
    "blackIce": {
      "type": "boolean",
      "default": false,
      "description": "Black ICE: a failed Icebreak against this block eliminates the attacker."
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "boundarySpaces": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "minItems": 6,
      "maxItems": 6,
      "description": "Derived boundary-space ids: E1â†’h3, E2â†’h4, E3â†’h5, E4â†’h6, E5â†’h7, E6â†’h2 when the corresponding entrance is open."
    },
    "bonusFragments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "default": 0
    },
    "bonusCorners": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inCybernet": {
          "$ref": "#/$defs/effect"
        },
        "underControl": {
          "$ref": "#/$defs/effect"
        }
      }
    },
    "assetRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "provisional": {
      "type": "boolean",
      "default": false
    },
    "nonPlayableZoneIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/zoneId"
      },
      "description": "Source-reviewed layout zones occupied by title/art rather than gameplay spaces. No movement, capacity or entrance is created for these zones."
    },
    "spaceArrows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "zoneId": {
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "h7"
      ]
    },
    "capacity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "unlimited"
        }
      ]
    },
    "effect": {
      "description": "A block effect: a bare source effect-id (legacy) or a typed action.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "gain-control-card",
                "place-pawn",
                "place-neutral-pawn",
                "area-attack",
                "all-players",
                "modify-ice",
                "custom",
                "discard-per-controlled-pawn",
                "return-control-marker",
                "sacrifice-per-player",
                "gain-bonus-all-players",
                "controller-core",
                "place-controlled-pawn",
                "attack-pawn",
                "discard-hands-above-markers",
                "discard-pawn-attachments",
                "place-block-bonus",
                "collect-block-bonus"
              ]
            },
            "amount": {
              "type": "integer"
            },
            "target": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "description": "Printed effect text; required when kind is custom."
            },
            "minimumControlledPawns": {
              "type": "integer",
              "minimum": 1
            },
            "scope": {
              "enum": [
                "adjacent-blocks",
                "cybernet"
              ]
            },
            "optional": {
              "const": true
            },
            "markerThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "space": {
      "type": "object",
      "required": [
        "id",
        "type",
        "zoneIds",
        "capacity",
        "neighbors"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "enum": [
            "normal",
            "special",
            "pawn",
            "effect",
            "event",
            "drone"
          ]
        },
        "zoneIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/zoneId"
          },
          "description": "One or more standardized internal placement hexes selected by this gameplay space."
        },
        "capacity": {
          "$ref": "#/$defs/capacity"
        },
        "displayShape": {
          "enum": [
            "auto",
            "circle",
            "capsule",
            "compound"
          ],
          "default": "auto",
          "description": "Source-facing editor rendering only; it never changes gameplay capacity or movement."
        },
        "capacityNote": {
          "type": "string",
          "minLength": 1,
          "description": "Required source-review explanation when capacity differs from the default for selected zones."
        },
        "neighbors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "Gameplay-space links used by executable space-to-space movement."
        },
        "pawnId": {
          "type": "string"
        },
        "effectId": {
          "type": "string"
        },
        "direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Directional restriction (printed arrow): a pawn may only leave this space toward this edge index (0=top, then clockwise)."
        },
        "modifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "defense",
                "hand-size",
                "attack",
                "ice"
              ]
            },
            "amount": {
              "type": "integer"
            },
            "dice": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "shielded"
                ],
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "shielded": {
                    "type": "boolean"
                  }
                }
              },
              "description": "Exact printed defense faces: set shielding for each named face; never interpret as ICE or a numeric count."
            }
          },
          "required": [
            "kind"
          ]
        },
        "threatId": {
          "type": "string"
        },
        "effect": {
          "type": "object",
          "required": [
            "kind",
            "cardType",
            "scope",
            "optional"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "discard-attachment"
              ]
            },
            "cardType": {
              "enum": [
                "add-on",
                "gadget"
              ]
            },
            "scope": {
              "enum": [
                "cybernet"
              ]
            },
            "optional": {
              "const": true,
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
