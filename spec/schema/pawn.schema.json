{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaibatsu/spec/schema/pawn.schema.json",
  "title": "Pawn",
  "description": "An agent: piece (position) + control card (attributes). See DOCS/domain-model.md.",
  "type": "object",
  "required": [
    "id",
    "name",
    "expansion",
    "class",
    "defense",
    "movement"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "expansion": {
      "enum": [
        "speedrunners",
        "shadowraiders"
      ]
    },
    "class": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "description": "Printed class badges; classless pawns such as Idoru have an empty array."
    },
    "defense": {
      "type": "array",
      "description": "Defense dice; a match on an unshielded die eliminates the pawn.",
      "items": {
        "$ref": "#/$defs/defenseDie"
      }
    },
    "movement": {
      "$ref": "#/$defs/movement"
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ability"
      },
      "default": []
    },
    "iceValue": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "black"
      ],
      "default": "none"
    },
    "slots": {
      "type": "array",
      "items": {
        "enum": [
          "add-on",
          "gadget",
          "weapon",
          "armor",
          "module",
          "mission"
        ]
      },
      "default": []
    },
    "special": {
      "type": "string"
    },
    "isStarter": {
      "type": "boolean",
      "default": false,
      "description": "One of the drawable starting pawns (Speedrunner/Shadowraider)."
    },
    "mercCost": {
      "type": "integer",
      "minimum": 0,
      "description": "Bonus-counter cost to recruit (mercenary)."
    },
    "assetRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "description": "Physical asset ids resolved through spec/assets/manifest.json."
    },
    "artwork": {
      "$ref": "#/$defs/artwork"
    },
    "provisional": {
      "type": "boolean",
      "default": false
    },
    "iceFaces": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "uniqueItems": true
    },
    "icebreakerModifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faces": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "uniqueItems": true
        },
        "rollDice": {
          "type": "integer",
          "minimum": 0
        },
        "black": {
          "type": "boolean"
        },
        "ignoresBlackIce": {
          "type": "boolean"
        }
      }
    },
    "color": {
      "type": "string"
    },
    "controlMarkerEffect": {
      "type": "object",
      "required": [
        "kind",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "place-on-control-card"
          ]
        },
        "amount": {
          "const": 1,
          "type": "integer"
        }
      }
    },
    "phaseEffects": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger",
          "kind",
          "amount",
          "scope",
          "target",
          "optional"
        ],
        "properties": {
          "trigger": {
            "const": "begin-turn"
          },
          "kind": {
            "const": "steal-random-card"
          },
          "amount": {
            "const": 1
          },
          "scope": {
            "const": "cybernet"
          },
          "target": {
            "const": "another-pawn"
          },
          "optional": {
            "const": true
          }
        }
      }
    },
    "abilityTurn": {
      "enum": [
        "any-player-turn"
      ],
      "description": "Printed permission to activate this controlled pawn’s abilities during any player’s turn. It does not permit movement, attaching cards, other pawns or interleaving an unresolved action."
    }
  },
  "$defs": {
    "defenseDie": {
      "type": "object",
      "required": [
        "value",
        "shielded"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "shielded": {
          "type": "boolean"
        }
      }
    },
    "artwork": {
      "type": "object",
      "required": [
        "assetId",
        "width",
        "height",
        "rect"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "rect": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "movement": {
      "type": "object",
      "required": [
        "type",
        "activation"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "steps",
            "d6",
            "2d6",
            "hex"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "activation": {
          "enum": [
            "card",
            "once-per-turn",
            "none"
          ]
        }
      }
    },
    "ability": {
      "type": "object",
      "required": [
        "ability",
        "activation"
      ],
      "additionalProperties": false,
      "properties": {
        "ability": {
          "enum": [
            "search",
            "delete",
            "reboot",
            "icebreaker"
          ]
        },
        "activation": {
          "enum": [
            "card",
            "once-per-turn",
            "none"
          ]
        },
        "skulls": {
          "type": "integer",
          "minimum": 1,
          "description": "Attack dice for Delete."
        }
      }
    }
  }
}
