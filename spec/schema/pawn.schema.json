{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaibatsu/spec/schema/pawn.schema.json",
  "title": "Pawn",
  "description": "An agent: piece (position) + control card (attributes). See DOCS/domain-model.md.",
  "type": "object",
  "required": ["id", "name", "expansion", "class", "defense", "movement"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "expansion": { "enum": ["speedrunners", "shadowraiders"] },
    "class": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Open set of class-types (operative, drone, cyborg, ...)."
    },
    "defense": {
      "type": "array",
      "description": "Defense dice; a match on an unshielded die eliminates the pawn.",
      "items": { "$ref": "#/$defs/defenseDie" }
    },
    "movement": { "$ref": "#/$defs/movement" },
    "abilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ability" },
      "default": []
    },
    "iceValue": { "enum": ["none", "low", "medium", "high", "black"], "default": "none" },
    "slots": {
      "type": "array",
      "items": { "enum": ["add-on", "gadget", "weapon", "armor", "module", "mission"] },
      "default": []
    },
    "special": { "type": "string" },
    "isStarter": {
      "type": "boolean",
      "default": false,
      "description": "One of the drawable starting pawns (Speedrunner/Shadowraider)."
    },
    "mercCost": { "type": "integer", "minimum": 0, "description": "Bonus-counter cost to recruit (mercenary)." },
    "assetRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true,
      "description": "Physical asset ids resolved through spec/assets/manifest.json."
    },
    "provisional": { "type": "boolean", "default": false }
  },
  "$defs": {
    "defenseDie": {
      "type": "object",
      "required": ["value", "shielded"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 6 },
        "shielded": { "type": "boolean" }
      }
    },
    "movement": {
      "type": "object",
      "required": ["type", "activation"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["steps", "d6", "2d6", "hex"] },
        "steps": { "type": "integer", "minimum": 0 },
        "activation": { "enum": ["card", "once-per-turn", "none"] }
      }
    },
    "ability": {
      "type": "object",
      "required": ["ability", "activation"],
      "additionalProperties": false,
      "properties": {
        "ability": { "enum": ["search", "delete", "reboot", "icebreaker"] },
        "activation": { "enum": ["card", "once-per-turn", "none"] },
        "skulls": { "type": "integer", "minimum": 1, "description": "Attack dice for Delete." }
      }
    }
  }
}
