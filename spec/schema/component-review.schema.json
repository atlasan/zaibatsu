{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-executable component visual review",
  "type": "object",
  "required": ["reviewVersion", "reviewedOn", "reviewer", "scope", "coverage", "records"],
  "additionalProperties": false,
  "properties": {
    "reviewVersion": {"const": 1},
    "reviewedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "coverage": {"type": "object", "required": ["assets", "parts", "byKind", "originalSources", "archiveMembers"]},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "game", "kind", "name", "reviewStatus", "provisional", "source", "image", "transcription", "description", "details", "actions", "inheritedRules", "specificInstructions", "parts", "unresolved", "symbolKeys", "existingGameplayRef", "canonicalPromotion"],
      "properties": {
        "assetId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "game": {"enum": ["speedrunners", "shadowraiders", "shared"]},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "reviewStatus": {"const": "visual-reviewed"},
        "provisional": {"const": true},
        "source": {"type": "object", "required": ["artifactId", "path", "page", "locator", "authority", "language", "sha256", "member", "memberSha256"]},
        "image": {"type": "object", "required": ["path", "sha256", "renderDpi", "crop"]},
        "transcription": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "rulesText", "rawExtractedText", "conventions"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "rulesText": {"type": ["string", "null"]},
            "rawExtractedText": {"type": "string"},
            "conventions": {"type": "string", "minLength": 1}
          }
        },
        "description": {"type": "string", "minLength": 1},
        "details": {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "category", "symbols", "bonusCounterCost", "timing", "modifiers", "rewards", "restrictions"],
          "properties": {
            "classification": {"type": ["string", "null"]},
            "category": {"type": "string", "minLength": 1},
            "symbols": {"$ref": "#/$defs/strings"},
            "bonusCounterCost": {"type": ["integer", "null"], "minimum": 1},
            "timing": {"$ref": "#/$defs/strings"},
            "modifiers": {"$ref": "#/$defs/strings"},
            "rewards": {"$ref": "#/$defs/strings"},
            "restrictions": {"$ref": "#/$defs/strings"}
          }
        },
        "actions": {"$ref": "#/$defs/strings"},
        "inheritedRules": {"type": "array", "items": {"type": "object", "required": ["artifactId", "locator", "instruction"]}},
        "specificInstructions": {"type": "string", "minLength": 1},
        "parts": {
          "type": "array", "items": {
            "type": "object", "required": ["partId", "name", "locator", "printedText", "description", "actions", "specificInstructions"],
            "properties": {
              "partId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "name": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "printedText": {"type": ["string", "null"]},
              "description": {"type": "string", "minLength": 1},
              "actions": {"$ref": "#/$defs/strings"},
              "specificInstructions": {"type": "string", "minLength": 1},
              "relatedReviewId": {"type": ["string", "null"]},
              "relatedPartId": {"type": "string"}
            }
          }
        },
        "unresolved": {"$ref": "#/$defs/strings"},
        "symbolKeys": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["artifactId", "locator"]}},
        "existingGameplayRef": {"type": ["object", "null"]},
        "canonicalPromotion": {"type": "string", "minLength": 1}
      }
    }
  }
}
