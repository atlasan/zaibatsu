{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaibatsu/spec/schema/block-layout-override.schema.json",
  "title": "Per-asset block layout overrides",
  "type": "object", "required": ["overrides"], "additionalProperties": false,
  "properties": { "overrides": { "type": "array", "items": { "type": "object", "required": ["assetId", "layoutId", "note", "transform"], "additionalProperties": false, "properties": { "assetId": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "layoutId": { "const": "standard-seven-small-hex-grid" }, "note": { "type": "string", "minLength": 1 }, "transform": { "type": "object", "required": ["offsetX", "offsetY", "scale"], "additionalProperties": false, "properties": { "offsetX": { "type": "number", "minimum": -50, "maximum": 50 }, "offsetY": { "type": "number", "minimum": -50, "maximum": 50 }, "scale": { "type": "number", "exclusiveMinimum": 0.25, "maximum": 2 } } } } } } }
}