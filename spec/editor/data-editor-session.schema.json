{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaibatsu/spec/editor/data-editor-session.schema.json",
  "title": "Zaibatsu data editor session v3",
  "description": "Local review state for blocks and action cards; it is not canonical game data.",
  "type": "object",
  "required": ["sessionVersion", "projectId", "assetManifestPath", "documents"],
  "additionalProperties": false,
  "properties": {
    "sessionVersion": { "const": 3 },
    "projectId": { "const": "zaibatsu-data-editor" },
    "assetManifestPath": { "const": "spec/assets/manifest.json" },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "history": { "type": "array" }
  },
  "$defs": {
    "document": {
      "oneOf": [
        { "$ref": "#/$defs/blockDocument" },
        { "$ref": "#/$defs/actionCardDocument" }
      ]
    },
    "base": {
      "type": "object",
      "required": ["id", "resourceType", "title", "status", "source", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "review", "verified"] },
        "source": { "type": "object", "required": ["assetId"], "properties": { "assetId": { "type": "string" } } },
        "provenance": { "type": "object", "required": ["primaryArtifactId", "page", "locator"], "properties": { "primaryArtifactId": { "type": "string" }, "page": { "type": "integer", "minimum": 1 }, "locator": { "type": "string", "minLength": 1 } } },
        "annotations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "blockDocument": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["block"], "properties": { "resourceType": { "const": "block" }, "block": { "$ref": "../schema/block.schema.json" } } }] },
    "actionCardDocument": {
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["actionCard", "transcription"], "properties": {
        "resourceType": { "const": "action-card" },
        "actionCard": { "$ref": "../schema/action-card.schema.json" },
        "transcription": { "type": "object", "required": ["printedText", "reviewerConfirmed", "duplicateGroupConfirmed"], "properties": { "printedText": { "type": "string" }, "reviewerConfirmed": { "type": "boolean" }, "duplicateGroupConfirmed": { "type": "boolean" } } }
      } }]
    }
  }
}
