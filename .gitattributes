# Normalize line endings: store text as LF in the repo, regardless of platform.
# Keeps the Go + TS mirrors byte-consistent across Windows/macOS/Linux.
* text=auto eol=lf

# Binary/asset types (never normalized).
*.png binary
*.pdf binary
*.rar binary
*.lockb binary

# Frozen regression evidence includes pre-existing CRLF schema hashes.
# Preserve its exact bytes on every platform.
spec/fixtures/provisional-v1/** -text
